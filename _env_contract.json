  "providerContracts": [
    {
      "provider": "StreamYard Custom RTMP",
      "usage": "Producer studio/source. Operator pastes generated LiveKit RTMP URL/stream key into StreamYard.",
      "proof": "manual real provider smoke with operator-confirmed private broadcast or UNPROVEN"
    },
    {
      "provider": "LiveKit",
      "usage": "Ingress and embedded attendee distribution.",
      "proof": "real CreateIngress + webhook + attendee browser proof or UNPROVEN"
    },
    {
      "provider": "Daily",
      "usage": "fallback attendee stage when StreamYard feed or LiveKit distribution fails.",
      "proof": "fallback smoke or UNPROVEN"
    },
    {
      "provider": "Supabase",
      "usage": "production persistence/auth-adjacent data.",
      "proof": "provider integration tests with safe test data or UNPROVEN"
    },
    {
      "provider": "Cloudflare Worker/OpenNext",
      "usage": "deployed app runtime.",
      "proof": "GitHub deploy + postdeploy smoke/E2E or UNPROVEN"
    }
  ],
  "localEnvRestore": {
    "strategy": "external-private-vault-or-backup-discovery",
    "gpgEnvVar": "AGENCY_EVENT_OS_ENV_GPG_PATH",
    "plainEnvVar": "AGENCY_EVENT_OS_ENV_LOCAL_PATH",
    "legacyPlainEnvVar": "AGENCY_EVENT_OS_ENV_BACKUP",
    "encryptedVaultCandidates": [
      "~/.config/agency-event-os/agency-event-os.env.local.gpg",
      "~/agency-event-os.env.local.gpg"
    ],
    "plainEnvCandidates": [
      "~/agency-event-os.env.local.backup"
    ],
    "repoPolicy": "Real secret vaults are intentionally external to baseline ZIP artifacts; wrapper restores from local private path, runs the command, and removes .env.local if it created it."
  },
  "optionalDevEnv": [
    "CLOUDFLARE_ACCOUNT_ID",
